    { "id": "start", "kind": "contains", "frame": 0, "pattern": "Count:\\s*0" },
    { "id": "inc1", "kind": "contains", "frame": 1, "pattern": "Count:\\s*1" },
    { "id": "inc2", "kind": "contains", "frame": 2, "pattern": "Count:\\s*2" },
    { "id": "dec", "kind": "contains", "frame": 3, "pattern": "Count:\\s*1" }
  ]
}
