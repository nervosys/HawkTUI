{
  "id": "g1-counter",
  "name": "counter",
  "rung": 1,
  "frame_format": "tree",
  "grid": { "w": 240, "h": 120 },
  "script": ["click:inc", "click:inc", "key:q"],
  "checks": [
    { "id": "quits", "kind": "frame_count", "equals": 3, "contract": true },

    { "id": "title", "kind": "contains", "frame": 0, "pattern": "Counter" },
    { "id": "starts-at-zero", "kind": "contains", "frame": 0, "pattern": "Count: *0" },

    { "id": "inc-addressable", "kind": "has_widget", "frame": 0, "agent_id": "inc" },
    { "id": "count-addressable", "kind": "has_widget", "frame": 0, "agent_id": "count" },
    { "id": "title-addressable", "kind": "has_widget", "frame": 0, "agent_id": "title" },

    { "id": "first-click", "kind": "contains", "frame": 1, "pattern": "Count: *1" },
    { "id": "second-click", "kind": "contains", "frame": 2, "pattern": "Count: *2" },
    { "id": "click-changes-the-tree", "kind": "frames_differ", "a": 0, "b": 1 },

    { "id": "no-ansi", "kind": "absent", "frame": 0, "pattern": "\\x1b\\[" }
  ]
}
